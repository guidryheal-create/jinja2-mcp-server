# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Jinja2 Configuration
JINJA_MCP__JINJA__TEMPLATE_DIRS=templates,examples/templates
JINJA_MCP__JINJA__AUTOESCAPE=true
JINJA_MCP__JINJA__CACHE_SIZE=400
JINJA_MCP__JINJA__AUTO_RELOAD=true
JINJA_MCP__JINJA__MAX_TEMPLATE_SIZE=1048576
JINJA_MCP__JINJA__MAX_RENDER_TIME=30.0

# Security Configuration
JINJA_MCP__SECURITY__MAX_LOOP_ITERATIONS=10000
JINJA_MCP__SECURITY__MAX_RECURSION_DEPTH=100
JINJA_MCP__SECURITY__ALLOW_FILE_ACCESS=false

# Logging Configuration
JINJA_MCP__LOGGING__LEVEL=DEBUG
JINJA_MCP__LOGGING__ENABLE_STRUCTLOG=true
JINJA_MCP__LOGGING__LOG_FILE=logs/jinja-mcp-server.log

# MCP Configuration
JINJA_MCP__MCP__NAME=jinja-mcp-server
JINJA_MCP__MCP__VERSION=0.1.0
JINJA_MCP__MCP__STDIO=true
JINJA_MCP__MCP__ENABLE_ALL_TOOLS=true 